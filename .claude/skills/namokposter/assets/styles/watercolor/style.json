{
  "id": "watercolor",
  "label": "Watercolour Wash",
  "engine": "three",
  "mood": "hand-made and quiet — translucent, overlapping watercolour washes on paper with pooled edges, a few fine parallel pen lines and plenty of bare sheet for the copy. Good for book talks, exhibitions, weddings and invitations, seasonal greetings, craft and culture programmes.",
  "kind": "picture",
  "tone": "light",
  "type": "editorial",
  "types": ["myeongjo", "story", "melody", "calli", "maru", "luxe", "hand", "swiss", "goun"],
  "defaultPalette": "rose",
