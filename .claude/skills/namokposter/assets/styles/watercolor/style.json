  "params": {
    "size": {
      "default": 1.0,
      "note": "0.5 = small blooms … 1.8 = large washes"
    },
    "depth": {
      "default": 1.0,
      "note": "0.4 = pale, few layers … 1.8 = saturated"
    },
    "wet": {
      "default": 1.0,
      "note": "0 = flat colour … 2 = strong pooling at the wash edges"
    },
    "grain": {
      "default": 1.0,
      "note": "paper tooth and granulation (0–2)"
    },
    "ink": {
      "default": 1.0,
      "note": "0 = no pen work … 3 = many parallel pen lines and dotted trails"
    },
    "splatter": {
      "default": 1.0,
      "note": "0 = none … 3 = many droplets around the washes"
    }
  },
  "layouts": {
