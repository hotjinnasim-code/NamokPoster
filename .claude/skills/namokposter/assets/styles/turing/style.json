  "params": {
    "pattern": {
      "default": "coral",
      "note": "core of the drift: coral = long combed stripes … worms = shorter broken stripes … spots = packed dots (the rim is always dots)"
    },
    "flow": {
      "default": 1.0,
      "note": "0.7 = loosely combed … 1.5 = very straight grain (stripes always share one direction)"
    },
    "scale": {
      "default": 1.0,
      "note": "0.6 = fine pattern … 1.8 = large"
    },
    "relief": {
      "default": 1.0,
      "note": "0 = flat print … 2 = deep emboss"
    },
    "buds": {
      "default": 1.0,
      "note": "0–1 strength of the third-colour buds at stripe tips and inside dots"
    },
    "spread": {
      "default": 1.0,
      "note": "0.5 = a narrow drift at the focus … 2 = fills more of the sheet"
    },
    "steps": {
      "default": 2600,
      "note": "simulation steps (fewer = younger, blobbier pattern)"
    }
  },
