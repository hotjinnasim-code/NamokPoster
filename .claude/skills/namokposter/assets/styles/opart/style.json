  "params": {
    "motif": {
      "default": "sphere",
      "note": "how the sheet is bent: sphere (a ball pressing through the grid) | wave (ripples slanting across the stripes) | fold (pleated like a paper screen)"
    },
    "pattern": {
      "default": "auto",
      "note": "what is printed on it: auto | stripes | checks | dots (auto = checks on the sphere, stripes on wave and fold)"
    },
    "density": {
      "default": 1,
      "note": "pattern fineness: 0.6 = bold … 1.8 = fine"
    },
    "bend": {
      "default": 1,
      "note": "strength of the bulge / ripple / pleat, 0.4–1.5"
    },
    "fade": {
      "default": 1,
      "note": "how far from the copy the print reaches full weight: 0.5 = abrupt … 1.8 = long taper"
    },
    "angle": {
      "default": "auto",
      "note": "rotation of the print in degrees, or auto (chosen from the seed)"
    }
  },
