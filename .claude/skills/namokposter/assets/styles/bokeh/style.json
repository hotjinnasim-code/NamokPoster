  "params": {
    "motif": {
      "default": "city",
      "note": "what the lights hint at: city | string | lantern | glitter"
    },
    "density": {
      "default": 1.0,
      "note": "0.5 = few lights … 2 = crowded"
    },
    "size": {
      "default": 1.0,
      "note": "blur-disc size multiplier (how far out of focus)"
    },
    "rim": {
      "default": 1.0,
      "note": "brightness of the disc rims: 0 = flat discs … 2 = soap-bubble rings"
    },
    "cateye": {
      "default": 1.0,
      "note": "how strongly discs are squeezed into cat's eyes towards the corners (0 = all round)"
    },
    "blades": {
      "default": 0,
      "note": "0 = round aperture; 5–9 = softly polygonal discs"
    },
    "glow": {
      "default": 1.0,
      "note": "bloom around the lights"
    },
    "grain": {
      "default": 1.0,
      "note": "film grain (0–2)"
    }
  },
