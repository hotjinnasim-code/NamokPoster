  },
  "params": {
    "flow": {
      "default": 1.0,
      "note": "how far the flow bends the rings: 0.4 = near-concentric agate … 1.5 = long wandering veins"
    },
    "veins": {
      "default": 1.0,
      "note": "ring density at the heart: 0.6 = broad pools … 1.8 = many fine veins"
    },
    "strokes": {
      "default": 1,
      "note": "stylus strokes drawn through the rings, each dragging them into a feather: 0–2 (parallel, never crossing)"
    },
    "drops": {
      "default": 2,
      "note": "later, smaller drops that land in the outer rings and push them aside, 0–5"
    },
    "gilt": {
      "default": 1.0,
      "note": "amount of metallic hairline: 0 = none … 1 = most pool edges gilded"
    },
    "scale": {
      "default": 1.0,
      "note": "size of the main drop"
    }
  },
  "vars": {
    "--scrim-center": 0.3,
    "--grain": 0.14
  },
  "layouts": {
    "landscape": {
      "layout": "left",
      "also": [
