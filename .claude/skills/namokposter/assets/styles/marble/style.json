{
  "id": "marble",
  "label": "Fluid Marbling",
  "engine": "three",
  "mood": "a full picture — a flow painting like paper marbling or a paint pour: rings of pigment bent into veins and pools, edged with fine gilded hairlines, dense at the focus and opening into large calm pools of the paper colour behind the copy. Elegant, tactile. Good for exhibitions, craft and design fairs, beauty and fragrance, weddings, book covers, premium invitations.",
  "kind": "picture",
  "tone": "light",
  "type": "luxe",
  "types": [
    "editorial",
    "calli",
    "myeongjo",
    "elegant"
  ],
  "defaultPalette": "ivory",
  "palettes": {
